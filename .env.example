# TailorFit AI Environment Variables
PORT=3002
OMNIROUTE_API_KEY=your_nvidia_nim_or_openrouter_api_key_here
OMNIROUTE_GATEWAY_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
JWT_SECRET=your_production_jwt_secret_key_here

# --- Supabase (optional, production persistence) ---
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, ALL data (users,
# analyses) is stored in Supabase Postgres via PostgREST (tables:
# tailorfit_users, tailorfit_analyses) instead of the local sql.js file
# (resume_tailor.db). Leave unset to keep local SQLite dev mode.
# Get both values from your Supabase project: Settings -> API.
# Note: SUPABASE_URL may also be provided as NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>
